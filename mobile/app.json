{
  "expo": {
    "name": "ايام كناوية",
    "slug": "ayam-knawyeh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "ayamknawyeh",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8b0000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayamknawyeh.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "LSApplicationQueriesSchemes": [
          "fb",
          "instagram",
          "tiktok",
          "whatsapp",
          "fb",
          "instagram",
          "tiktok",
          "whatsapp"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "supportsRtl": true,
      "forcesRtl": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8b0000"
      },
      "package": "com.ayamknawyeh.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#e62020"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7fd46ac6-5e64-4e37-8c7d-fa57874c90b0"
      }
    }
  }
}
